generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  language     String   @default("bn")
  role         String   @default("user") // user, admin, super_admin
  createdAt    DateTime @default(now()) @map("created_at")

  profile              Profile?
  healthLogs           HealthLog[]
  mealPlans            MealPlan[]
  chatMessages         ChatMessage[]
  mealTrackings        MealTracking[]
  medicineReminders    MedicineReminder[]
  personalCookerChats  PersonalCookerChat[]
  subscriptions        UserSubscription[]
  tokenUsages          TokenUsage[]
  grocerySuggestions   GrocerySuggestion[]

  @@map("users")
}

model Profile {
  userId            String   @id @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nameBn            String?  @map("name_bn")
  nameEn            String?  @map("name_en")
  age               Int?
  gender            String?
  weightKg          Float?   @map("weight_kg")
  heightCm          Float?   @map("height_cm")
  activityLevel     String?  @map("activity_level")
  goal              String?
  medicalConditions String?  @map("medical_conditions")
  preferredFoods    String?  @map("preferred_foods")
  dislikedFoods     String?  @map("disliked_foods")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model HealthLog {
  logId         String   @id @default(uuid()) @map("log_id")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  logDate       DateTime @default(now()) @map("log_date")
  weightKg      Float?   @map("weight_kg")
  bloodPressure String?  @map("blood_pressure")
  bloodSugar    Float?   @map("blood_sugar")
  hba1c         Float?
  notes         String?
  symptoms      String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("health_logs")
}

model MealPlan {
  planId          String   @id @default(uuid()) @map("plan_id")
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planDate        DateTime @map("plan_date")
  planType        String   @map("plan_type")
  planData        String   @map("plan_data")
  calorieTarget   Int      @map("calorie_target")
  aiSuggestionCal Int?     @map("ai_suggestion_cal")
  userChoiceCal   Int?     @map("user_choice_cal")
  language        String
  feedback        Int?
  completedSlots  String?  @map("completed_slots") // JSON array: ["breakfast","lunch"]
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("meal_plans")
}

model ChatMessage {
  messageId    String   @id @default(uuid()) @map("message_id")
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role         String
  content      String
  intent       String?
  groceryData  String?  @map("grocery_data") // JSON: grocery suggestion payload
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("chat_messages")
}

model MealTracking {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  inputText   String   @map("input_text")
  parsedItems String   @map("parsed_items")  // JSON: [{name, calories, protein_g, carbs_g, fat_g, amount_g}]
  totalCals   Int      @map("total_calories")
  macros      String                          // JSON: {protein_g, carbs_g, fat_g}
  feedback    String
  mealSlot    String?  @map("meal_slot")     // breakfast / lunch / dinner / snack
  language    String   @default("en")
  loggedAt    DateTime @default(now()) @map("logged_at")

  @@map("meal_tracking")
}

model MedicineReminder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String                    // "Metformin"
  dose      String                    // "500mg"
  times     String                    // JSON: ["08:30", "20:30"]
  withFood  Boolean  @map("with_food") @default(false)
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("medicine_reminders")
}

model PersonalCookerChat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String   @map("session_id")
  role      String
  content   String
  condition String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, sessionId])
  @@map("personal_cooker_chats")
}

// ─── Subscription & Business Dashboard Models ─────────────────────────

model SubscriptionPlan {
  id               String   @id @default(uuid())
  name             String
  tier             String   // free, basic, pro, premium
  priceMonthlyBDT  Int      @map("price_monthly_bdt")
  priceYearlyBDT   Int      @map("price_yearly_bdt")
  features         String   // JSON array of strings
  aiTokenQuota     Int      @map("ai_token_quota")
  maxSavedMeals    Int      @map("max_saved_meals")
  maxFamilyMembers Int      @map("max_family_members")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscriptions    UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String   @map("plan_id")
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])

  status             String   // trial, active, cancelled, expired, past_due
  startedAt          DateTime @default(now()) @map("started_at")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelReason       String?  @map("cancel_reason")
  mrrBDT             Int      @default(0) @map("mrr_bdt")
  paymentMethod      String?  @map("payment_method") // bkash, nagad, card, rocket, ssl
  autoRenew          Boolean  @default(true) @map("auto_renew")
  trialEndsAt        DateTime? @map("trial_ends_at")

  @@map("user_subscriptions")
}

model TokenUsage {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date             DateTime @default(now())
  feature          String   // chat, meal_plan, recipe, voice, nutrition_scan
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  costUSD          Float    @default(0) @map("cost_usd")

  @@map("token_usages")
}

model GrocerySuggestion {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessageId String? @map("chat_message_id")

  itemName     String   @map("item_name")
  platform     String   // chaldal, kiksha, rokomari, daraz, etc.
  priceBDT     Float?   @map("price_bdt")
  clickedAt    DateTime @default(now()) @map("clicked_at")
  purchasedAt  DateTime? @map("purchased_at")

  @@map("grocery_suggestions")
}

model AdminAccessLog {
  id         String   @id @default(uuid())
  ipAddress  String?  @map("ip_address")
  accessedAt DateTime @default(now()) @map("accessed_at")
  success    Boolean
  password   String?  // hashed or masked for debugging

  @@map("admin_access_logs")
}
